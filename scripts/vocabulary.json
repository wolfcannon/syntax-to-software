{
  "_comment": [
    "The course's vocabulary ledger: which step first shows each piece of Python.",
    "scripts/check_vocabulary.py enforces it \u2014 no page may USE syntax in learner-",
    "visible code before the step that teaches it. Prose may mention anything, as",
    "long as it signposts (the block says 'step N'), because forward signposting",
    "is orientation rather than assumed knowledge.",
    "'position' is the course order: a step's own number, interludes in between.",
    "'prose_terms' covers words rather than syntax: a page must not lean on 'kernel' or 'DataFrame' before the learner has one. A paragraph may still use the word if it signposts where it comes from (says 'step N' or 'level-up')."
  ],
  "positions": {
    "step-01": 1,
    "step-02": 2,
    "step-03": 3,
    "step-04": 4,
    "step-05": 5,
    "step-06": 6,
    "step-07": 7,
    "step-08": 8,
    "step-09": 9,
    "step-10": 10,
    "interlude-jupyter": 10.5,
    "step-11": 11,
    "step-12": 12,
    "step-13": 13,
    "step-14": 14,
    "step-15": 15,
    "step-16": 16,
    "step-17": 17,
    "step-18": 18,
    "interlude-scripts": 18.5,
    "step-19": 19,
    "step-20": 20,
    "step-21": 21,
    "step-22": 22,
    "step-23": 23
  },
  "concepts": [
    {
      "name": "f-string",
      "step": 3,
      "patterns": [
        "f\"[^\"]*\\{",
        "f'[^']*\\{"
      ]
    },
    {
      "name": "str method",
      "step": 3,
      "patterns": [
        "\\.(zfill|startswith|strip|split|replace|lower|upper|join)\\("
      ]
    },
    {
      "name": "indexing",
      "step": 3,
      "patterns": [
        "\\w\\[\\d+\\]"
      ]
    },
    {
      "name": "slice",
      "step": 3,
      "patterns": [
        "\\w\\[\\d*:\\d*\\]"
      ]
    },
    {
      "name": "sorted(key=)",
      "step": 6,
      "patterns": [
        "sorted\\([^)]*key\\s*="
      ]
    },
    {
      "name": "lambda",
      "step": 6,
      "patterns": [
        "\\blambda\\b"
      ]
    },
    {
      "name": "enumerate",
      "step": 7,
      "patterns": [
        "\\benumerate\\("
      ]
    },
    {
      "name": ".append",
      "step": 6,
      "patterns": [
        "\\.append\\("
      ]
    },
    {
      "name": "dict literal",
      "step": 8,
      "patterns": [
        "^(?:(?!f[\"']).)*\\{\\s*[\"'][^\"']+[\"']\\s*:"
      ]
    },
    {
      "name": "dict .get",
      "step": 8,
      "patterns": [
        "\\.get\\("
      ]
    },
    {
      "name": "zip",
      "step": 8,
      "patterns": [
        "\\bzip\\("
      ]
    },
    {
      "name": "dict .items/.values",
      "step": 8,
      "patterns": [
        "\\.(items|values|keys)\\("
      ]
    },
    {
      "name": "for loop",
      "step": 7,
      "patterns": [
        "^\\s*for\\s+\\w"
      ]
    },
    {
      "name": "if statement",
      "step": 5,
      "patterns": [
        "^\\s*if\\s+",
        "^\\s*elif\\s+"
      ]
    },
    {
      "name": "while loop",
      "step": 7,
      "patterns": [
        "^\\s*while\\s+"
      ]
    },
    {
      "name": "continue/break",
      "step": 7,
      "patterns": [
        "^\\s*(continue|break)\\b"
      ]
    },
    {
      "name": "list comprehension",
      "step": 9,
      "patterns": [
        "\\[[^\\]]*\\bfor\\b[^\\]]*\\]"
      ]
    },
    {
      "name": "dict/set comprehension",
      "step": 9,
      "patterns": [
        "\\{[^}]*\\bfor\\b[^}]*\\}"
      ]
    },
    {
      "name": "set operations",
      "step": 9,
      "patterns": [
        "\\bset\\(",
        "\\w\\s[-&|]\\s\\w+_ids\\b"
      ]
    },
    {
      "name": "def",
      "step": 10,
      "patterns": [
        "^\\s*def\\s+\\w"
      ]
    },
    {
      "name": "return",
      "step": 10,
      "patterns": [
        "^\\s*return\\b"
      ]
    },
    {
      "name": "try/except",
      "step": 13,
      "patterns": [
        "^\\s*try:",
        "^\\s*except\\b"
      ]
    },
    {
      "name": "raise",
      "step": 13,
      "patterns": [
        "^\\s*raise\\b"
      ]
    },
    {
      "name": "open()/with",
      "step": 14,
      "patterns": [
        "^\\s*with\\s+",
        "\\bopen\\("
      ]
    },
    {
      "name": "import",
      "step": 15,
      "patterns": [
        "^\\s*import\\s+\\w",
        "^\\s*from\\s+[\\w.]+\\s+import\\b"
      ]
    },
    {
      "name": "class",
      "step": 16,
      "patterns": [
        "^\\s*class\\s+\\w"
      ]
    },
    {
      "name": "third-party library",
      "step": 17,
      "patterns": [
        "\\b(pd|np|plt|pandas|numpy|matplotlib|scipy|geopandas)\\."
      ]
    },
    {
      "name": "requests",
      "step": 18,
      "patterns": [
        "\\brequests\\.(get|post)\\("
      ]
    },
    {
      "name": "pytest",
      "step": 20,
      "patterns": [
        "\\bpytest\\b"
      ]
    }
  ],
  "exemptions": [
    {
      "page": "step-04",
      "concept": "if statement",
      "why": "the blocks page uses an if as scenery \u2014 the learner predicts output and moves a line, never writes a condition. Conditions are step 5"
    }
  ],
