  "concepts": [
    {
      "name": "f-string",
      "step": 3,
      "patterns": [
        "f\"[^\"]*\\{",
        "f'[^']*\\{"
      ]
    },
    {
      "name": "str method",
      "step": 3,
      "patterns": [
        "\\.(zfill|startswith|strip|split|replace|lower|upper|join)\\("
      ]
    },
    {
      "name": "slice",
      "step": 3,
      "patterns": [
        "\\w\\[\\d*:\\d*\\]"
      ]
    },
    {
      "name": "sorted(key=)",
      "step": 4,
      "patterns": [
        "sorted\\([^)]*key\\s*="
      ]
    },
    {
      "name": "lambda",
      "step": 4,
      "patterns": [
        "\\blambda\\b"
      ]
    },
    {
      "name": "enumerate",
      "step": 4,
      "patterns": [
        "\\benumerate\\("
      ]
    },
    {
      "name": ".append",
      "step": 4,
      "patterns": [
        "\\.append\\("
      ]
    },
    {
      "name": "dict literal",
      "step": 5,
      "patterns": [
        "^(?:(?!f[\"']).)*\\{\\s*[\"'][^\"']+[\"']\\s*:"
      ]
    },
    {
      "name": "dict .get",
      "step": 5,
      "patterns": [
        "\\.get\\("
      ]
    },
    {
      "name": "zip",
      "step": 5,
      "patterns": [
        "\\bzip\\("
      ]
    },
    {
      "name": "dict .items/.values",
      "step": 5,
      "patterns": [
        "\\.(items|values|keys)\\("
      ]
    },
    {
      "name": "for loop",
      "step": 6,
      "patterns": [
        "^\\s*for\\s+\\w"
      ]
    },
    {
      "name": "if statement",
      "step": 6,
      "patterns": [
        "^\\s*if\\s+",
        "^\\s*elif\\s+"
      ]
    },
    {
      "name": "while loop",
      "step": 6,
      "patterns": [
        "^\\s*while\\s+"
      ]
    },
    {
      "name": "continue/break",
      "step": 6,
      "patterns": [
        "^\\s*(continue|break)\\b"
      ]
    },
    {
      "name": "list comprehension",
      "step": 7,
      "patterns": [
        "\\[[^\\]]*\\bfor\\b[^\\]]*\\]"
      ]
    },
    {
      "name": "dict/set comprehension",
      "step": 7,
      "patterns": [
        "\\{[^}]*\\bfor\\b[^}]*\\}"
      ]
    },
    {
      "name": "set operations",
      "step": 7,
      "patterns": [
        "\\bset\\(",
        "\\w\\s[-&|]\\s\\w+_ids\\b"
      ]
    },
    {
      "name": "def",
      "step": 8,
      "patterns": [
        "^\\s*def\\s+\\w"
      ]
    },
    {
      "name": "return",
      "step": 8,
      "patterns": [
        "^\\s*return\\b"
      ]
    },
    {
      "name": "try/except",
      "step": 11,
      "patterns": [
        "^\\s*try:",
        "^\\s*except\\b"
      ]
    },
    {
      "name": "raise",
      "step": 11,
      "patterns": [
        "^\\s*raise\\b"
      ]
    },
    {
      "name": "open()/with",
      "step": 12,
      "patterns": [
        "^\\s*with\\s+",
        "\\bopen\\("
      ]
    },
    {
      "name": "import",
      "step": 13,
      "patterns": [
        "^\\s*import\\s+\\w",
        "^\\s*from\\s+[\\w.]+\\s+import\\b"
      ]
    },
    {
      "name": "class",
      "step": 14,
      "patterns": [
        "^\\s*class\\s+\\w"
      ]
    },
    {
      "name": "third-party library",
      "step": 15,
      "patterns": [
        "\\b(pd|np|plt|pandas|numpy|matplotlib|scipy|geopandas)\\."
      ]
    },
    {
      "name": "requests",
      "step": 16,
      "patterns": [
        "\\brequests\\.(get|post)\\("
      ]
    },
    {
      "name": "pytest",
      "step": 18,
      "patterns": [
        "\\bpytest\\b"
      ]
    }
  ],
